<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A stronger focus halo on the radio buttons and switches; the accent is the Warm palette's. -->
    <style name="ColourFieldsTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:colorControlHighlight">#66FFFFFF</item>
        <item name="android:colorAccent">#FF7E5F</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
    </style>

    <style name="SettingsChoice">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="android:minWidth">128dp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="SettingsButton">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">@drawable/settings_button</item>
        <item name="android:textColor">@color/settings_button_text</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
