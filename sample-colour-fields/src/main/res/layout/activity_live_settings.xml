<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="48dp"
        android:paddingTop="27dp"
        android:paddingEnd="48dp"
        android:paddingBottom="27dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_name"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/live_settings_note"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <LinearLayout
            android:id="@+id/testing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                style="@style/SettingsLabel"
                android:text="@string/settings_testing" />

            <!-- The end of a row keeps RIGHT; FocusFinder would jump to the row above. -->
            <Switch
                android:id="@+id/never_draw"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:nextFocusRight="@id/never_draw"
                android:padding="8dp"
                android:text="@string/live_never_draw" />

            <Switch
                android:id="@+id/crash"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:nextFocusRight="@id/crash"
                android:padding="8dp"
                android:text="@string/live_crash" />

            <Switch
                android:id="@+id/unsupported"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:nextFocusRight="@id/unsupported"
                android:padding="8dp"
                android:text="@string/live_unsupported" />

            <Switch
                android:id="@+id/slow_release"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:nextFocusRight="@id/slow_release"
                android:padding="8dp"
                android:text="@string/live_slow_release" />

            <Switch
                android:id="@+id/ask_events"
                android:layout_width="320dp"
                android:layout_height="wrap_content"
                android:nextFocusRight="@id/ask_events"
                android:padding="8dp"
                android:text="@string/live_ask_events" />
        </LinearLayout>

        <Button
            android:id="@+id/done"
            style="@style/SettingsButton"
            android:layout_width="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="160dp"
            android:nextFocusRight="@id/done"
            android:text="@string/settings_done" />
    </LinearLayout>
</ScrollView>
