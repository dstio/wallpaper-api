<?xml version="1.0" encoding="utf-8"?>
<!-- The app icon: the preview's gradient. A shape, not a vector: a vector's gradient needs API 24. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="#B24592"
        android:endColor="#1B2A55"
        android:startColor="#FF7E5F"
        android:type="linear" />
    <size
        android:width="108dp"
        android:height="108dp" />
</shape>
